<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="zad_inventory.view.gui.guiAdmin.guiCategorias.guiCategoriasOpcoes.GuiCategoriasLista">
  <grid id="27dc6" binding="panelListaCategorias" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="590" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="bc13d" binding="panelTitulo" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="10" left="10" bottom="10" right="10"/>
        <constraints>
